# Sao chép thành config.env (KHÔNG commit). Tạo token: python -c "import secrets; print(secrets.token_urlsafe(48))"
QR_TOKEN_BAO_CAO=
# Bản giá/tồn CÔNG KHAI (sku, ten, gia, ton{30LL,VV,BT,TP,BD}, thong_so). Có trường giá vốn/NCC là bị từ chối.
QR_TEP_GIA_LIVE=\\SERVER_DIENMAYV\DMV_Sync\qr-gia-live.json
QR_THU_MUC_DU_LIEU=D:\VIP DATA\QR Cua Hang\du-lieu
# SĐT khách: thư mục riêng, KHÔNG trong G:\My Drive / DMV-Cloud-Bridge / DMV_Sync (app từ chối khởi động nếu sai)
QR_THU_MUC_RIENG_TU=D:\VIP DATA\QR Cua Hang\rieng-tu
# Chuông đọc mỗi tệp qr-tu-van-*.json trong thư mục này để báo nhân viên
QR_THU_MUC_CHUONG=C:\DMV_Sync\_bus\to-chuong-qr
QR_TUOI_GIA_TOI_DA_GIAY=900
# --- Phần nhân viên (quét cùng tem, bấm "Nhân viên" cuối trang) ---
# Mã nhân viên, mỗi mã ≥ 8 ký tự, cách nhau dấu phẩy. Bỏ trống = tắt phần nhân viên.
QR_MA_NHAN_VIEN=
# Mỗi đề nghị chuyển kho / đặt NCC = 1 tệp qr-de-nghi-*.json (trạng thái cho_duyet) cho Chuông/HTsoft
QR_THU_MUC_YEU_CAU=C:\DMV_Sync\_bus\to-chuong-qr-de-nghi
QR_NGUONG_SAP_HET=2
QR_NGUONG_TON_LON=30
